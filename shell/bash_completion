#!/usr/bin/env bash

# bash completion for Node Version Manager (NVM)
# Changed by nvmimic: the nvmimic program works the suggestions out, flags
# included, and the `nvmimic` command is completed too. Generated by
# `cargo xtask gen-shell`.

if ! command -v nvm &> /dev/null; then
  return
fi

__nvm_generate_completion() {
  declare current_word
  current_word="${COMP_WORDS[COMP_CWORD]}"
  # shellcheck disable=SC2207
  COMPREPLY=($(compgen -W "$1" -- "${current_word}"))
  return 0
}

__nvm_commands() {
  declare current_word
  declare command

  current_word="${COMP_WORDS[COMP_CWORD]}"

  COMMANDS='
    help install uninstall use run exec
    alias unalias reinstall-packages
    current list ls list-remote ls-remote
    install-latest-npm
    cache deactivate unload
    version version-remote which'

  if [ ${#COMP_WORDS[@]} == 4 ]; then

    command="${COMP_WORDS[COMP_CWORD - 2]}"
    case "${command}" in
      alias) __nvm_installed_nodes ;;
    esac

  else

    case "${current_word}" in
      -*) __nvm_options ;;
      *) __nvm_generate_completion "${COMMANDS}" ;;
    esac

  fi
}

__nvm_options() {
  OPTIONS=''
  __nvm_generate_completion "${OPTIONS}"
}

__nvm_installed_nodes() {
  __nvm_generate_completion "$(nvm_ls) $(__nvm_aliases)"
}

__nvm_aliases() {
  declare aliases
  aliases=""
  if [ -d "${NVM_DIR}/alias" ]; then
    aliases="$(__nvmimic_handoff __nvm_aliases)"
  fi
  echo "${aliases} node stable unstable iojs"
}

__nvm_alias() {
  __nvm_generate_completion "$(__nvm_aliases)"
}

__nvm() {
  declare previous_word
  previous_word="${COMP_WORDS[COMP_CWORD - 1]}"

  # nvm's own completion sets COMMANDS and OPTIONS on its way and leaves
  # them set. The same happens here, in the same places.
  case "${previous_word}" in
    use | run | exec | ls | list | uninstall | alias | unalias) ;;
    *)
      COMMANDS='
    help install uninstall use run exec
    alias unalias reinstall-packages
    current list ls list-remote ls-remote
    install-latest-npm
    cache deactivate unload
    version version-remote which'
      if [ ${#COMP_WORDS[@]} != 4 ]; then
        case "${COMP_WORDS[COMP_CWORD]}" in
          -*) OPTIONS='' ;;
        esac
      fi
    ;;
  esac

  local IFS='
'
  # shellcheck disable=SC2207
  COMPREPLY=($(__nvmimic_handoff __nvm_complete bash "${COMP_CWORD}" "${COMP_WORDS[@]}"))

  # A flag that ends in `=` wants its value right behind it, with no space
  # in between. bash 4 and later can switch the space off for one answer.
  # bash 3.2 has no way to, so there the space stays.
  if [ "${#COMPREPLY[@]}" -eq 1 ]; then
    case "${COMPREPLY[0]-}" in
      *=) type compopt > /dev/null 2>&1 && compopt -o nospace ;;
    esac
  fi
  return 0
}

# complete is a bash builtin, but recent versions of ZSH come with a function
# called bashcompinit that will create a complete in ZSH. If the user is in
# ZSH, load and run bashcompinit before calling the complete function.
if [[ -n ${ZSH_VERSION-} ]]; then
  # First calling compinit (only if not called yet!)
  # and then bashcompinit as mentioned by zsh man page.
  if ! command -v compinit > /dev/null; then
    autoload -U +X compinit && if [[ ${ZSH_DISABLE_COMPFIX-} = true ]]; then
      compinit -u
    else
      compinit
    fi
  fi
  autoload -U +X bashcompinit && bashcompinit
fi

complete -o default -F __nvm nvm
complete -o default -F __nvm nvmimic

# zsh's own completion system can show a few words beside each suggestion,
# which `complete` has no way to pass on. Where that system is running, nvm
# and nvmimic are registered with it directly.
if [[ -n ${ZSH_NAME-} ]] && command -v compdef > /dev/null; then
  eval '_nvmimic_complete() {
    local -a suggestions
    suggestions=("${(@f)$(__nvmimic_handoff __nvm_complete zsh "$((CURRENT - 1))" "${words[@]}")}")
    suggestions=(${suggestions:#})
    (( $#suggestions )) || return 1
    # A flag that ends in `=` wants its value right behind it, so those
    # are added with nothing after them.
    local -a open
    open=(${(M)suggestions:#*=(|:*)})
    suggestions=(${suggestions:|open})
    _describe -V suggestion suggestions -- open -S ""
  }'
  compdef _nvmimic_complete nvm nvmimic
fi
